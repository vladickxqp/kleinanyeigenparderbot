# ============================================================================
#  Kleinanzeigen Parser Bot — Environment configuration
#  Copy this file to `.env` and fill in the real values.
#  NEVER commit the real `.env` file.
# ============================================================================

# --- General ---------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true
TZ=Europe/Berlin

# --- Telegram --------------------------------------------------------------
# Get a fresh token from @BotFather. Do NOT reuse a leaked token.
BOT_TOKEN=CHANGE_ME_WITH_A_FRESH_BOTFATHER_TOKEN
# Comma-separated Telegram user IDs that are treated as bot admins.
BOT_ADMIN_IDS=
# Long polling by default. For webhook mode set these:
BOT_USE_WEBHOOK=false
BOT_WEBHOOK_BASE_URL=
BOT_WEBHOOK_PATH=/webhook
BOT_WEBHOOK_SECRET=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=parserbot
# REQUIRED: generate a real one, the app refuses to start in production otherwise
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=parserbot

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Celery ----------------------------------------------------------------
# Leave empty to derive from REDIS_* above.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- API / Security --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# REQUIRED: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Anyone who knows this value can mint an admin token for the panel.
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Admin panel login -----------------------------------------------------
# Bootstrap admin account for the web panel. Generate the hash with:
#   python -c "from app.api.security import hash_password; print(hash_password('YOUR_PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Premium subscription (Telegram Stars) ----------------------------------
# All limits are configurable here — never hardcoded.
PREMIUM_ENABLED=true
PREMIUM_PRICE_STARS=250              # ~4.99 EUR, charged monthly via Telegram
PREMIUM_PRICE_EUR=4.99               # display/revenue estimate only
PREMIUM_PERIOD_DAYS=31               # days granted per successful charge
FREE_MAX_RULES=3
PRO_MAX_RULES=25
UNLIMITED_MAX_RULES=1000000
FREE_MIN_INTERVAL_SECONDS=600        # free tier checks at most every 10 min
PAID_MIN_INTERVAL_SECONDS=60         # premium checks up to every minute
TRIAL_ENABLED=true
TRIAL_DAYS=7                         # 3 / 7 / 14 - free trial, once per user
REFERRAL_ENABLED=true
REFERRAL_REWARD_DAYS=7               # free days for the inviter per first purchase
RESALE_FEE_PERCENT=13.0              # marketplace fees in the net-profit estimate
RESALE_SHIPPING_EUR=5.90             # flat shipping cost in the net-profit estimate
NEGO_DISCOUNT_PERCENT=12.0           # default discount the negotiation helper offers
PHOTO_AI_PREMIUM_ONLY=true           # photo evaluation only for premium (admins always)

# --- Telegram Mini App (needs a public HTTPS URL) ------------------------------
# 1) buy a domain, 2) create a Cloudflare Tunnel that points to the frontend
#    container (http://frontend:80), 3) put the public URL + /app here.
WEBAPP_URL=                          # e.g. https://deals.example.com/app (empty = hidden)
CLOUDFLARE_TUNNEL_TOKEN=             # token from Cloudflare Zero Trust → Tunnels

# --- Scraping --------------------------------------------------------------
SCRAPER_DEFAULT_INTERVAL_SECONDS=300
SCRAPER_REQUEST_TIMEOUT=25
SCRAPER_MAX_CONCURRENCY=4            # concurrent scrapes INSIDE one worker process
CELERY_CONCURRENCY=2                 # worker processes (multiplies the line above)
SCRAPER_MIN_DELAY_SECONDS=2.0        # polite delay between requests to one site
SCRAPER_MAX_RETRIES=3
# Optional rotating proxy pool, comma-separated (http://user:pass@host:port)
SCRAPER_PROXIES=
# Playwright headless browser
PLAYWRIGHT_HEADLESS=true

# --- Optional: AI scoring --------------------------------------------------
# If unset, the bot falls back to heuristic (non-AI) deal scoring.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Monitoring ------------------------------------------------------------
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# --- Backups (the backup container writes into ./backups) ----------------------
BACKUP_INTERVAL_SECONDS=86400        # one dump per day
BACKUP_KEEP_DAYS=14                  # older dumps are deleted
BACKUP_PING_URL=                     # optional: healthchecks.io URL pinged on success

# --- Monitoring ----------------------------------------------------------------
# Dead-man's switch: the worker pings this URL every minute. If the laptop,
# Docker or Postgres dies, the ping stops and the service alerts YOU — nothing
# running on the same machine could ever report its own outage.
# Free option: https://healthchecks.io (create a check, paste its ping URL)
HEALTHCHECK_PING_URL=
# Alert when no search has been dispatched for this long (seconds).
WATCHDOG_MAX_DISPATCH_AGE=600
# Alert when the Celery queue stays longer than this (tasks).
WATCHDOG_MAX_QUEUE_DEPTH=100
# Alert when the disk has less than this much free space (percent).
WATCHDOG_MIN_DISK_FREE_PERCENT=10
