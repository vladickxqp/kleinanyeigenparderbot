# ============================================================================
#  Kleinanzeigen Parser Bot — Environment configuration
#  Copy this file to `.env` and fill in the real values.
#  NEVER commit the real `.env` file.
# ============================================================================

# --- General ---------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true
TZ=Europe/Berlin

# --- Telegram --------------------------------------------------------------
# Get a fresh token from @BotFather. Do NOT reuse a leaked token.
BOT_TOKEN=CHANGE_ME_WITH_A_FRESH_BOTFATHER_TOKEN
# Comma-separated Telegram user IDs that are treated as bot admins.
BOT_ADMIN_IDS=
# Long polling by default. For webhook mode set these:
BOT_USE_WEBHOOK=false
BOT_WEBHOOK_BASE_URL=
BOT_WEBHOOK_PATH=/webhook
BOT_WEBHOOK_SECRET=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=parserbot
# REQUIRED: generate a real one, the app refuses to start in production otherwise
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=parserbot

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Celery ----------------------------------------------------------------
# Leave empty to derive from REDIS_* above.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- API / Security --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# REQUIRED: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Anyone who knows this value can mint an admin token for the panel.
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Admin panel login -----------------------------------------------------
# Bootstrap admin account for the web panel. Generate the hash with:
#   python -c "from app.api.security import hash_password; print(hash_password('YOUR_PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Premium subscription (Telegram Stars) ----------------------------------
# All limits are configurable here — never hardcoded.
PREMIUM_ENABLED=true
PREMIUM_PERIOD_DAYS=31               # days granted per successful charge
STARS_PER_EUR=50                     # one ledger-wide rate (250 stars ~ 4.99 EUR)

# --- The four levels -------------------------------------------------------
# Plans are denominated in scrape requests per minute, the resource a single
# home connection really limits. Each level has a BASE interval for its
# searches plus FAST SLOTS: searches allowed to run at the level's fastest
# interval. Load per user = fast_slots * 60/fast + rest * 60/base.
# One IP at SCRAPER_MIN_DELAY_SECONDS=2 carries about 30 requests per minute.
STARTER_PRICE_STARS=350              # ~6.99 EUR
STARTER_PRICE_EUR=6.99
PRO_PRICE_STARS=750                  # ~14.99 EUR
PRO_PRICE_EUR=14.99
DEALER_PRICE_STARS=1500              # ~29.99 EUR ("Haendler")
DEALER_PRICE_EUR=29.99

FREE_MAX_RULES=3
STARTER_MAX_RULES=10
PRO_MAX_RULES=30
DEALER_MAX_RULES=100

FREE_BASE_INTERVAL_SECONDS=600
STARTER_BASE_INTERVAL_SECONDS=300
PRO_BASE_INTERVAL_SECONDS=300
DEALER_BASE_INTERVAL_SECONDS=180

FREE_MIN_INTERVAL_SECONDS=600
STARTER_MIN_INTERVAL_SECONDS=120
PRO_MIN_INTERVAL_SECONDS=60
DEALER_MIN_INTERVAL_SECONDS=60

FREE_FAST_SLOTS=0
STARTER_FAST_SLOTS=3
PRO_FAST_SLOTS=10
DEALER_FAST_SLOTS=25

# Absolute floor: below this the marketplaces start blocking, so no level
# may promise it, whatever the price.
SCRAPER_HARD_MIN_INTERVAL_SECONDS=60

# Worker queue per level; "express" is drained first, then "priority".
FREE_QUEUE_NAME=celery
STARTER_QUEUE_NAME=priority
PRO_QUEUE_NAME=priority
DEALER_QUEUE_NAME=express

# --- Quotas (-1 = unlimited) ------------------------------------------------
FREE_DAILY_NOTIFICATIONS=10          # the wall an active free user feels in week one
STARTER_DAILY_NOTIFICATIONS=100
PRO_DAILY_NOTIFICATIONS=500
DEALER_DAILY_NOTIFICATIONS=-1
NOTIFICATION_CAP_TEASER_ENABLED=true # name what is withheld instead of going silent

FREE_PHOTO_EVALS_PER_MONTH=1
STARTER_PHOTO_EVALS_PER_MONTH=5
PRO_PHOTO_EVALS_PER_MONTH=30
DEALER_PHOTO_EVALS_PER_MONTH=-1
PHOTO_EVALS_FAIR_USE_PER_DAY=30      # brake on "unlimited" against script abuse

FREE_QUICK_SEARCHES_PER_DAY=3
STARTER_QUICK_SEARCHES_PER_DAY=20
PRO_QUICK_SEARCHES_PER_DAY=100
DEALER_QUICK_SEARCHES_PER_DAY=-1
FREE_QUICK_SEARCH_COOLDOWN_SECONDS=120
STARTER_QUICK_SEARCH_COOLDOWN_SECONDS=60
PRO_QUICK_SEARCH_COOLDOWN_SECONDS=30
DEALER_QUICK_SEARCH_COOLDOWN_SECONDS=15

FREE_NEGOTIATIONS_PER_MONTH=3
STARTER_NEGOTIATIONS_PER_MONTH=-1
PRO_NEGOTIATIONS_PER_MONTH=-1
DEALER_NEGOTIATIONS_PER_MONTH=-1

FREE_MAX_SITES_PER_RULE=1            # free searches Kleinanzeigen only
STARTER_MAX_SITES_PER_RULE=-1
PRO_MAX_SITES_PER_RULE=-1
DEALER_MAX_SITES_PER_RULE=-1

# How long finds and price history are kept, per level.
FREE_HISTORY_DAYS=14
STARTER_HISTORY_DAYS=90
PRO_HISTORY_DAYS=365
DEALER_HISTORY_DAYS=1095
RETENTION_SWEEP_ENABLED=true
# After a downgrade the shorter window only bites once the user has been on the
# lower level this long. Dropping a year of history to two weeks the same night
# is a data loss nobody agreed to.
HISTORY_GRACE_DAYS=30
RETENTION_BATCH_LIMIT=5000

# Hidden daily run budget per user: the headline is the promise, this is the
# dial that keeps it affordable. Never advertise these numbers.
FREE_MAX_RUNS_PER_DAY=500
STARTER_MAX_RUNS_PER_DAY=4000
PRO_MAX_RUNS_PER_DAY=12000
DEALER_MAX_RUNS_PER_DAY=30000

# Features per level, comma separated.
FREE_FEATURES=
STARTER_FEATURES=flip_mode
PRO_FEATURES=flip_mode,rule_power,export,market_report
DEALER_FEATURES=flip_mode,rule_power,export,market_report,forwarding

# The Haendler plan is only offered once a proxy pool exists: one dealer at
# full speed needs more requests per minute than a single home IP can carry.
DEALER_REQUIRES_PROXIES=true

# On a suspected block, widen every interval before alerting the admins.
BLOCK_BACKOFF_ENABLED=true
BLOCK_BACKOFF_SECONDS=900
BLOCK_BACKOFF_MULTIPLIER=3.0

# Show "found X min after posting" on every card.
CARD_SHOW_LATENCY=true

# --- Trial -----------------------------------------------------------------
TRIAL_ENABLED=true
TRIAL_DAYS=3                         # 72 h is enough to feel the difference
TRIAL_TIER=pro                       # never the top level: trials cost the same requests
REFERRAL_ENABLED=true
REFERRAL_REWARD_DAYS=7               # free days for the inviter per first purchase
RESALE_FEE_PERCENT=13.0              # marketplace fees in the net-profit estimate
RESALE_SHIPPING_EUR=5.90             # flat shipping cost in the net-profit estimate
NEGO_DISCOUNT_PERCENT=12.0           # default discount the negotiation helper offers
PHOTO_AI_PREMIUM_ONLY=false          # emergency switch; quotas normally decide

# --- Telegram Mini App (needs a public HTTPS URL) ------------------------------
# 1) buy a domain, 2) create a Cloudflare Tunnel that points to the frontend
#    container (http://frontend:80), 3) put the public URL + /app here.
WEBAPP_URL=                          # e.g. https://deals.example.com/app (empty = hidden)
CLOUDFLARE_TUNNEL_TOKEN=             # token from Cloudflare Zero Trust → Tunnels

# --- Scraping --------------------------------------------------------------
SCRAPER_DEFAULT_INTERVAL_SECONDS=300
SCRAPER_REQUEST_TIMEOUT=25
SCRAPER_MAX_CONCURRENCY=4            # concurrent scrapes INSIDE one worker process
CELERY_CONCURRENCY=2                 # worker processes (multiplies the line above)
SCRAPER_MIN_DELAY_SECONDS=2.0        # polite delay between requests to one site
SCRAPER_MAX_RETRIES=3
# Optional rotating proxy pool, comma-separated (http://user:pass@host:port)
SCRAPER_PROXIES=
# Playwright headless browser
PLAYWRIGHT_HEADLESS=true

# --- Optional: AI scoring --------------------------------------------------
# If unset, the bot falls back to heuristic (non-AI) deal scoring.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Monitoring ------------------------------------------------------------
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# --- Backups (the backup container writes into ./backups) ----------------------
BACKUP_INTERVAL_SECONDS=86400        # one dump per day
BACKUP_KEEP_DAYS=14                  # older dumps are deleted
BACKUP_PING_URL=                     # optional: healthchecks.io URL pinged on success

# --- Monitoring ----------------------------------------------------------------
# Dead-man's switch: the worker pings this URL every minute. If the laptop,
# Docker or Postgres dies, the ping stops and the service alerts YOU — nothing
# running on the same machine could ever report its own outage.
# Free option: https://healthchecks.io (create a check, paste its ping URL)
HEALTHCHECK_PING_URL=
# Alert when no search has been dispatched for this long (seconds).
WATCHDOG_MAX_DISPATCH_AGE=600
# Alert when the Celery queue stays longer than this (tasks).
WATCHDOG_MAX_QUEUE_DEPTH=100
# Alert when the disk has less than this much free space (percent).
WATCHDOG_MIN_DISK_FREE_PERCENT=10

# --- Marketplaces ------------------------------------------------------------
# AutoScout24 serves its result list as structured JSON inside the page and was
# verified live; cars are the highest-value category here.
AUTOSCOUT24_ENABLED=true
# Vinted's catalog endpoint moved and its field names are unconfirmed, so the
# parser stays off until one real response has been captured.
VINTED_ENABLED=false
# eBay refuses every scrape with HTTP 403 - with browser headers and without,
# from every address this was tried from. A parser that never delivers still
# joins every "all sites" rule and spends a request per run on a refusal, and
# a site that keeps failing takes itself out of the rotation anyway (see
# app/services/health.py). Switch on only after a live search from YOUR
# server has returned cards.
EBAY_ENABLED=false

# --- Sold comparables ---------------------------------------------------------
# No marketplace here publishes realised prices, but an ad that stops appearing
# was almost certainly sold — that is the only honest source we have.
SOLD_COMPS_ENABLED=true
SOLD_COMP_MISSING_RUNS=3             # consecutive misses before it counts as sold
SOLD_COMP_MAX_AGE_DAYS=45

# --- Searches in plain language ------------------------------------------------
# "Tesla Model 3 unter 25.000, hoechstens 100.000 km, 100 km um Worms" becomes a
# real search. The rule-based parser works without AI; AI only refines.
NL_RULES_ENABLED=true

# --- Exit addresses (capacity) --------------------------------------------------
# Pacing is per exit address, so each proxy adds a full request budget. The
# Haendler plan stays off the page until the pool covers what one subscriber of
# that level may generate.
# SCRAPER_PROXIES=http://user:pass@host:port,http://user:pass@host2:port

# --- Legal (required before selling to consumers in the EU) ---------------------
# Empty by default on purpose: these name a real operator at a real address, and
# this repository must not invent them. Until they are set, /rechtliches says the
# page does not exist yet, the purchase page shows no withdrawal hint, and
# /status keeps telling the admins what is missing.
#   §5 DDG  - imprint (provider, address, reachable contact)
#   §312g / §356 Abs. 5 BGB - withdrawal notice for a digital service
# The wording belongs to the operator (generator or a lawyer), not here.
LEGAL_OPERATOR=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
# Only if they exist:
LEGAL_REGISTER=
LEGAL_VAT_ID=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
# The notice a customer reads before paying:
LEGAL_WITHDRAWAL=
# Bump whenever the texts above change in substance; otherwise a fingerprint of
# the texts is recorded instead.
LEGAL_VERSION=

# --- Reposts -------------------------------------------------------------------
# The same offer under a new ad id: sellers delete and re-post to climb the
# result list, and the fresh id makes it look brand new. The card is withheld,
# the row is still stored (its price belongs in the statistics, and two sellers
# really can offer the same thing at the same price).
REPOST_SUPPRESSION_ENABLED=true
REPOST_WINDOW_DAYS=14
